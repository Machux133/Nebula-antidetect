diff --git a/base/nebula_fp.h b/base/nebula_fp.h
new file mode 100644
index 0000000..5f6a55c
--- /dev/null
+++ b/base/nebula_fp.h
@@ -0,0 +1,42 @@
+// Nebula Sessions: per-session device values passed by the session manager as
+// --nebula-fp="cores=8|ram=8|gpuv=...|gpur=...|plat=macOS|pver=14.5.0|arch=arm"
+// so every process (renderer, workers, network) reports the same modelled machine.
+
+#ifndef BASE_NEBULA_FP_H_
+#define BASE_NEBULA_FP_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+
+namespace nebula {
+
+inline constexpr char kSwitch[] = "nebula-fp";
+
+inline bool Has() {
+  return base::CommandLine::InitializedForCurrentProcess() &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch(kSwitch);
+}
+
+// Empty when the switch or the key is missing, so callers keep the real value.
+inline std::string Get(std::string_view key) {
+  if (!Has()) {
+    return std::string();
+  }
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kSwitch);
+  for (std::string_view kv : base::SplitStringPiece(
+           value, "|", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const size_t eq = kv.find('=');
+    if (eq != std::string_view::npos && kv.substr(0, eq) == key) {
+      return std::string(kv.substr(eq + 1));
+    }
+  }
+  return std::string();
+}
+
+}  // namespace nebula
+
+#endif  // BASE_NEBULA_FP_H_
