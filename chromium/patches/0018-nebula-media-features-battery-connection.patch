+// Nebula Sessions: the modelled screen's colour gamut (gamut=srgb|p3) and "default preferences" (mqdef=1: light
+// theme, no reduced motion/transparency/contrast, no forced or inverted colours). The host's own display and OS
+// settings (a wide-gamut monitor, dark mode, an accessibility option) would otherwise show through the media
+// features of a session that claims another machine.
+std::optional<ColorSpaceGamut> NebulaGamut() {
+  static const std::optional<ColorSpaceGamut> gamut =
+      []() -> std::optional<ColorSpaceGamut> {
+    const std::string value = nebula::Get("gamut");
+    if (value == "p3") {
+      return ColorSpaceGamut::P3;
+    }
+    if (value == "srgb") {
+      return ColorSpaceGamut::SRGB;
+    }
+    return std::nullopt;
+  }();
+  return gamut;
+}
+
+bool NebulaDefaultPreferences() {
+  static const bool on = nebula::Get("mqdef") == "1";
+  return on;
+}
+
