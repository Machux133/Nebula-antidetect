+namespace {
+
+struct NebulaConnection {
+  V8EffectiveConnectionType::Enum type;
+  uint32_t rtt_ms;
+  double downlink_mbps;
+};
+
+// Nebula Sessions: --nebula-fp conn=<slow-2g|2g|3g|4g>,<rtt ms>,<downlink Mbit/s>. The modelled machine's network
+// quality, for the same reason as the battery: this computer's measured values are not the claimed one's.
+std::optional<NebulaConnection> NebulaConnectionInfo() {
+  static const std::optional<NebulaConnection> info =
+      []() -> std::optional<NebulaConnection> {
+    const std::string spec = nebula::Get("conn");
+    const std::vector<std::string_view> f = base::SplitStringPiece(
+        spec, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    unsigned rtt = 0;
+    double downlink = 0;
+    if (f.size() != 3 || !base::StringToUint(f.at(1), &rtt) ||
+        !base::StringToDouble(f.at(2), &downlink)) {
+      return std::nullopt;
+    }
+    V8EffectiveConnectionType::Enum type;
+    if (f.at(0) == "slow-2g") {
+      type = V8EffectiveConnectionType::Enum::kSlow2G;
+    } else if (f.at(0) == "2g") {
+      type = V8EffectiveConnectionType::Enum::k2G;
+    } else if (f.at(0) == "3g") {
+      type = V8EffectiveConnectionType::Enum::k3G;
+    } else if (f.at(0) == "4g") {
+      type = V8EffectiveConnectionType::Enum::k4G;
+    } else {
+      return std::nullopt;
+    }
+    return NebulaConnection{type, rtt, downlink};
+  }();
+  return info;
+}
+
+}  // namespace
