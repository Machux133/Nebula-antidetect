+namespace {
+
+struct NebulaBattery {
+  double level;
+  bool charging;
+};
+
+// Nebula Sessions: --nebula-fp batt=<percent>,<charging 0/1>. The modelled machine's battery, whatever this
+// computer has: a desktop model is always "full, plugged in" (what Chrome reports without a battery), a laptop
+// has a level and a charging state. The times follow from them: charging takes up to 2 h to fill, a full battery
+// lasts 5 h, both in whole minutes; the one that does not apply is Infinity, as in Chrome.
+std::optional<NebulaBattery> NebulaBatteryStatus() {
+  static const std::optional<NebulaBattery> status =
+      []() -> std::optional<NebulaBattery> {
+    const std::string spec = nebula::Get("batt");
+    const std::vector<std::string_view> f = base::SplitStringPiece(
+        spec, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    unsigned percent = 0;
+    unsigned charging = 0;
+    if (f.size() != 2 || !base::StringToUint(f.at(0), &percent) ||
+        percent > 100 || !base::StringToUint(f.at(1), &charging)) {
+      return std::nullopt;
+    }
+    return NebulaBattery{percent / 100.0, charging != 0};
+  }();
+  return status;
+}
+
+}  // namespace
+
 bool BatteryManager::charging() {
+  if (const std::optional<NebulaBattery> nebula = NebulaBatteryStatus()) {
+    return nebula->charging;
+  }
   return battery_status_.Charging();
 }
 
 double BatteryManager::chargingTime() {
+  if (const std::optional<NebulaBattery> nebula = NebulaBatteryStatus()) {
+    return nebula->charging
+               ? std::round((1.0 - nebula->level) * 120.0) * 60.0
+               : std::numeric_limits<double>::infinity();
+  }
   return battery_status_.charging_time().InSecondsF();
 }
 
 double BatteryManager::dischargingTime() {
+  if (const std::optional<NebulaBattery> nebula = NebulaBatteryStatus()) {
+    return nebula->charging ? std::numeric_limits<double>::infinity()
+                            : std::round(nebula->level * 300.0) * 60.0;
+  }
   return battery_status_.discharging_time().InSecondsF();
 }
 
 double BatteryManager::level() {
+  if (const std::optional<NebulaBattery> nebula = NebulaBatteryStatus()) {
+    return nebula->level;
+  }
   return battery_status_.Level();
 }
 
