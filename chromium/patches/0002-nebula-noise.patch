diff --git a/third_party/blink/renderer/platform/graphics/nebula_noise.h b/third_party/blink/renderer/platform/graphics/nebula_noise.h
new file mode 100644
index 0000000..6892717
--- /dev/null
+++ b/third_party/blink/renderer/platform/graphics/nebula_noise.h
@@ -0,0 +1,123 @@
+// Nebula Sessions: seeded, deterministic noise for canvas, audio and client
+// rects. Keys inside --nebula-fp (set by the session manager); a key that is
+// present switches that noise on and its value is the seed:
+//   cn=<u32> canvas, an=<u32> audio, rn=<u32> client rects
+// Same seed + same input always gives the same output, so a session keeps a
+// stable hash across reloads, and different seeds give different hashes.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_NEBULA_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_NEBULA_NOISE_H_
+
+#include <bit>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/nebula_fp.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace blink::nebula_noise {
+
+inline std::optional<uint32_t> ParseSeed(std::string_view key) {
+  uint32_t v = 0;
+  if (base::StringToUint(nebula::Get(key), &v)) {
+    return v;
+  }
+  return std::nullopt;
+}
+
+// Cached: the command line never changes after start-up.
+inline std::optional<uint32_t> CanvasSeed() {
+  static const std::optional<uint32_t> seed = ParseSeed("cn");
+  return seed;
+}
+inline std::optional<uint32_t> AudioSeed() {
+  static const std::optional<uint32_t> seed = ParseSeed("an");
+  return seed;
+}
+inline std::optional<uint32_t> RectsSeed() {
+  static const std::optional<uint32_t> seed = ParseSeed("rn");
+  return seed;
+}
+inline bool CanvasOn() {
+  return CanvasSeed().has_value();
+}
+
+inline uint32_t Mix(uint32_t a, uint32_t b) {
+  uint32_t h = a * 0x9E3779B1u ^ (b + 0x7F4A7C15u);
+  h ^= h >> 15;
+  h *= 0x85EBCA6Bu;
+  h ^= h >> 13;
+  h *= 0xC2B2AE35u;
+  h ^= h >> 16;
+  return h;
+}
+
+// Moves ~1 in 8 pixels by one step in one colour channel. Only 8-bit RGBA/BGRA;
+// other formats (float, 565...) are left alone. Keeps premultiplied pixels valid.
+inline void NoisePixmap(const SkPixmap& pm) {
+  const std::optional<uint32_t> seed = CanvasSeed();
+  if (!seed || !pm.addr()) {
+    return;
+  }
+  if (pm.colorType() != kRGBA_8888_SkColorType &&
+      pm.colorType() != kBGRA_8888_SkColorType) {
+    return;
+  }
+  for (int y = 0; y < pm.height(); ++y) {
+    for (int x = 0; x < pm.width(); ++x) {
+      const uint32_t h = Mix(*seed, static_cast<uint32_t>(y) * 65537u + x);
+      if (h & 7) {
+        continue;
+      }
+      uint8_t* p = pm.writable_addr8(x, y);
+      const int ch = (h >> 3) % 3;
+      const bool up = (h >> 5) & 1;
+      if (UNSAFE_TODO(p[3]) == 0) {
+        continue;
+      }
+      if (up && UNSAFE_TODO(p[ch]) < UNSAFE_TODO(p[3])) {
+        UNSAFE_TODO(p[ch])++;
+      } else if (!up && UNSAFE_TODO(p[ch]) > 0) {
+        UNSAFE_TODO(p[ch])--;
+      }
+    }
+  }
+}
+
+// Relative change of at most 1e-7 per sample: inaudible, but the summed hash differs.
+inline void NoiseAudio(base::span<float> samples) {
+  const std::optional<uint32_t> seed = AudioSeed();
+  if (!seed) {
+    return;
+  }
+  for (size_t i = 0; i < samples.size(); ++i) {
+    const uint32_t h = Mix(*seed, static_cast<uint32_t>(i));
+    samples[i] *=
+        1.0f + (static_cast<float>(h & 0xFFFF) / 65535.0f - 0.5f) * 2e-7f;
+  }
+}
+
+// Width/height shift of at most 0.005 px, derived from the rect itself so the
+// same element measures the same every time.
+inline gfx::RectF NoiseRect(gfx::RectF r) {
+  const std::optional<uint32_t> seed = RectsSeed();
+  if (!seed || r.IsEmpty()) {
+    return r;
+  }
+  const uint32_t h = Mix(Mix(*seed, std::bit_cast<uint32_t>(r.width())),
+                         std::bit_cast<uint32_t>(r.height()));
+  r.set_width(r.width() +
+              (static_cast<float>(h & 0xFFFF) / 65535.0f - 0.5f) * 0.01f);
+  r.set_height(r.height() +
+               (static_cast<float>(h >> 16) / 65535.0f - 0.5f) * 0.01f);
+  return r;
+}
+
+}  // namespace blink::nebula_noise
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_NEBULA_NOISE_H_
