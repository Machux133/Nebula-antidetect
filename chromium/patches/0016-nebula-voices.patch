+// Nebula Sessions: --nebula-fp voices=<name>~<lang>~<local 0/1>~<default 0/1>;... (each field percent-encoded, so
+// the switch stays ASCII) is the modelled machine's voice list. The host's own list shows its OS and language
+// ("Microsoft Adam - Polish [pl-PL]") whatever the session claims. Empty: the real list is kept.
+Vector<mojom::blink::SpeechSynthesisVoicePtr> NebulaVoices() {
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> voices;
+  const std::string spec = nebula::Get("voices");
+  for (std::string_view entry : base::SplitStringPiece(
+           spec, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const std::vector<std::string_view> f = base::SplitStringPiece(
+        entry, "~", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    if (f.size() < 4) {
+      continue;
+    }
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->name = String::FromUtf8(base::UnescapeBinaryURLComponent(f[0]));
+    voice->voice_uri = voice->name;
+    voice->lang = String::FromUtf8(base::UnescapeBinaryURLComponent(f[1]));
+    voice->is_local_service = f[2] == "1";
+    voice->is_default = f[3] == "1";
+    voices.push_back(std::move(voice));
+  }
+  return voices;
+}
