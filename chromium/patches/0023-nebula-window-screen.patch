 }
 
 float MediaValues::CalculateDevicePixelRatio(LocalFrame* frame) {
+  // Same as window.devicePixelRatio, so `resolution` agrees with it.
+  double nebula_dpr;
+  if (base::StringToDouble(nebula::Get("dpr"), &nebula_dpr) &&
+      nebula_dpr > 0 && frame->GetPage()) {
+    const float device_scale = frame->GetPage()
+                                   ->GetChromeClient()
+                                   .GetScreenInfo(*frame)
+                                   .device_scale_factor;
+    if (device_scale > 0) {
+      return frame->DevicePixelRatio() * nebula_dpr / device_scale;
+    }
+  }
   return frame->DevicePixelRatio();
 }
 
