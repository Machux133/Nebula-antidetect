+// Nebula Sessions: kbd=gb|de|fr|es|it|ru, the layout of the session's language, as differences from US QWERTY.
+// ISO keyboards add the key next to the left Shift (IntlBackslash). Values are UTF-8.
+bool NebulaLayout(const std::string& name, HashMap<String, String>& map) {
+  struct Key {
+    const char* code;
+    const char* value;
+  };
+  static const Key kGb[] = {{"Backslash", "#"}, {"IntlBackslash", "\\"}};
+  static const Key kDe[] = {
+      {"Backquote", "^"}, {"Minus", "\xc3\x9f"}, {"Equal", "\xc2\xb4"},
+      {"BracketLeft", "\xc3\xbc"}, {"BracketRight", "+"}, {"Semicolon", "\xc3\xb6"},
+      {"Quote", "\xc3\xa4"}, {"Backslash", "#"}, {"Slash", "-"}, {"KeyY", "z"},
+      {"KeyZ", "y"}, {"IntlBackslash", "<"}};
+  static const Key kFr[] = {
+      {"Backquote", "\xc2\xb2"}, {"Digit1", "&"}, {"Digit2", "\xc3\xa9"}, {"Digit3", "\""},
+      {"Digit4", "'"}, {"Digit5", "("}, {"Digit6", "-"}, {"Digit7", "\xc3\xa8"},
+      {"Digit8", "_"}, {"Digit9", "\xc3\xa7"}, {"Digit0", "\xc3\xa0"}, {"Minus", ")"},
+      {"BracketLeft", "^"}, {"BracketRight", "$"}, {"Semicolon", "m"}, {"Quote", "\xc3\xb9"},
+      {"Backslash", "*"}, {"Comma", ";"}, {"Period", ":"}, {"Slash", "!"},
+      {"KeyA", "q"}, {"KeyQ", "a"}, {"KeyW", "z"}, {"KeyZ", "w"}, {"KeyM", ","},
+      {"IntlBackslash", "<"}};
+  static const Key kEs[] = {
+      {"Backquote", "\xc2\xba"}, {"Minus", "'"}, {"Equal", "\xc2\xa1"}, {"BracketLeft", "`"},
+      {"BracketRight", "+"}, {"Semicolon", "\xc3\xb1"}, {"Quote", "\xc2\xb4"},
+      {"Backslash", "\xc3\xa7"}, {"Slash", "-"}, {"IntlBackslash", "<"}};
+  static const Key kIt[] = {
+      {"Backquote", "\\"}, {"Minus", "'"}, {"Equal", "\xc3\xac"}, {"BracketLeft", "\xc3\xa8"},
+      {"BracketRight", "+"}, {"Semicolon", "\xc3\xb2"}, {"Quote", "\xc3\xa0"},
+      {"Backslash", "\xc3\xb9"}, {"Slash", "-"}, {"IntlBackslash", "<"}};
+  static const Key kRu[] = {
+      {"Backquote", "\xd1\x91"}, {"KeyQ", "\xd0\xb9"}, {"KeyW", "\xd1\x86"}, {"KeyE", "\xd1\x83"},
+      {"KeyR", "\xd0\xba"}, {"KeyT", "\xd0\xb5"}, {"KeyY", "\xd0\xbd"}, {"KeyU", "\xd0\xb3"},
+      {"KeyI", "\xd1\x88"}, {"KeyO", "\xd1\x89"}, {"KeyP", "\xd0\xb7"}, {"BracketLeft", "\xd1\x85"},
+      {"BracketRight", "\xd1\x8a"}, {"KeyA", "\xd1\x84"}, {"KeyS", "\xd1\x8b"}, {"KeyD", "\xd0\xb2"},
+      {"KeyF", "\xd0\xb0"}, {"KeyG", "\xd0\xbf"}, {"KeyH", "\xd1\x80"}, {"KeyJ", "\xd0\xbe"},
+      {"KeyK", "\xd0\xbb"}, {"KeyL", "\xd0\xb4"}, {"Semicolon", "\xd0\xb6"}, {"Quote", "\xd1\x8d"},
+      {"KeyZ", "\xd1\x8f"}, {"KeyX", "\xd1\x87"}, {"KeyC", "\xd1\x81"}, {"KeyV", "\xd0\xbc"},
+      {"KeyB", "\xd0\xb8"}, {"KeyN", "\xd1\x82"}, {"KeyM", "\xd1\x8c"}, {"Comma", "\xd0\xb1"},
+      {"Period", "\xd1\x8e"}, {"Slash", "."}};
+  base::span<const Key> diff;
+  if (name == "us") {
+    diff = {};
+  } else if (name == "gb") {
+    diff = kGb;
+  } else if (name == "de") {
+    diff = kDe;
+  } else if (name == "fr") {
+    diff = kFr;
+  } else if (name == "es") {
+    diff = kEs;
+  } else if (name == "it") {
+    diff = kIt;
+  } else if (name == "ru") {
+    diff = kRu;
+  } else {
+    return false;
+  }
+  map = NebulaUsLayout();
+  for (const Key& k : diff) {
+    map.Set(String(k.code), String::FromUtf8(k.value));
+  }
+  return true;
+}
+
 }
 
