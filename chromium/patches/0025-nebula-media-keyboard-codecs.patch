 String MediaStreamTrackImpl::label() const {
+  // Nebula Sessions: with the virtual camera/microphone on, the capture devices are named after the file path
+  // (C:\\Users\\<name>\\...), "fake_device_0" or "Fake Default Audio Input"; camname=/micname= is what the
+  // modelled machine shows instead.
+  const std::string nebula_label =
+      nebula::Get(kind() == "video" ? "camname" : "micname");
+  if (!nebula_label.empty()) {
+    return String::FromUtf8(nebula_label);
+  }
   return component_->GetSourceName();
 }
 
