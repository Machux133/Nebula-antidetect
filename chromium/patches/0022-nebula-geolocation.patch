+// Nebula Sessions: the session's modelled position, geo=<lat>,<lon>,<accuracy_m>
+// in --nebula-fp (derived from the proxy's location). Null when absent or
+// malformed, so the real providers run as usual.
+mojom::GeopositionResultPtr NebulaPosition(bool is_precise) {
+  const std::vector<std::string> parts =
+      base::SplitString(nebula::Get("geo"), ",", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_ALL);
+  mojom::GeopositionPtr position = mojom::Geoposition::New();
+  if (parts.size() != 3 ||
+      !base::StringToDouble(parts[0], &position->latitude) ||
+      !base::StringToDouble(parts[1], &position->longitude) ||
+      !base::StringToDouble(parts[2], &position->accuracy)) {
+    return nullptr;
+  }
+  position->timestamp = base::Time::Now();
+  position->is_precise = is_precise;
+  if (!ValidateGeoposition(*position)) {
+    return nullptr;
+  }
+  return mojom::GeopositionResult::NewPosition(std::move(position));
+}
