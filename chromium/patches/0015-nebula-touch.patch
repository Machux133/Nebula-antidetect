+namespace {
+
+// Nebula Sessions: the modelled device's input hardware, from the same `touch=` value that drives
+// navigator.maxTouchPoints, so (pointer)/(any-pointer)/(hover)/(any-hover) agree with it instead of
+// reporting the host's touch screen. touch=0: a mouse desktop. touch>0: a touch-only device.
+// nullopt (key absent): keep what the host reports.
+std::optional<bool> NebulaHasTouch() {
+  static const std::optional<bool> has_touch = []() -> std::optional<bool> {
+    unsigned points = 0;
+    if (!base::StringToUint(nebula::Get("touch"), &points)) {
+      return std::nullopt;
+    }
+    return points > 0;
+  }();
+  return has_touch;
+}
+
+}  // namespace
+
 mojom::blink::PointerType MediaValues::CalculatePrimaryPointerType(
     LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  if (const std::optional<bool> touch = NebulaHasTouch()) {
+    return *touch ? mojom::blink::PointerType::kPointerCoarseType
+                  : mojom::blink::PointerType::kPointerFineType;
+  }
   return frame->GetSettings()->GetPrimaryPointerType();
 }
 
 int MediaValues::CalculateAvailablePointerTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  if (const std::optional<bool> touch = NebulaHasTouch()) {
+    return static_cast<int>(*touch ? mojom::blink::PointerType::kPointerCoarseType
+                                   : mojom::blink::PointerType::kPointerFineType);
+  }
   return frame->GetSettings()->GetAvailablePointerTypes();
 }
 
