diff --git a/third_party/blink/renderer/core/frame/nebula_screen.h b/third_party/blink/renderer/core/frame/nebula_screen.h
new file mode 100644
index 0000000..888b42e
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/nebula_screen.h
@@ -0,0 +1,38 @@
+// Nebula Sessions: the modelled screen, read once from --nebula-fp
+// ("sw=1470|sh=956|ah=931|cd=30", CSS pixels). Used by window.screen and the
+// device-width/device-height media features, so both always agree. Missing keys
+// mean "use the real value".
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NEBULA_SCREEN_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NEBULA_SCREEN_H_
+
+#include "base/nebula_fp.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace blink::nebula_screen {
+
+struct Values {
+  int width = 0;
+  int height = 0;
+  int avail_height = 0;
+  int color_depth = 0;
+};
+
+inline const Values& Get() {
+  static const Values values = [] {
+    Values v;
+    base::StringToInt(nebula::Get("sw"), &v.width);
+    base::StringToInt(nebula::Get("sh"), &v.height);
+    base::StringToInt(nebula::Get("ah"), &v.avail_height);
+    base::StringToInt(nebula::Get("cd"), &v.color_depth);
+    if (v.width <= 0 || v.height <= 0) {
+      v = Values();
+    }
+    return v;
+  }();
+  return values;
+}
+
+}  // namespace blink::nebula_screen
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NEBULA_SCREEN_H_
