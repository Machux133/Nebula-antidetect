+namespace {
+
+// Nebula Sessions: Ctrl+Shift+V types the clipboard one character at a time, like the original's "Paste like a
+// human", instead of inserting it at once. Goes through the same textInput path as a key press; the page sees no
+// 'paste' event. Stops as soon as the target is no longer editable or the frame is gone.
+constexpr wtf_size_t kNebulaMaxTyped = 20000;
+
+void NebulaTypeNext(LocalFrame* frame, String text, wtf_size_t pos) {
+  if (!frame || !frame->GetDocument() || !frame->GetPage() ||
+      pos >= text.length() || !frame->Selection().SelectionHasFocus() ||
+      !frame->GetEditor().CanEdit()) {
+    return;
+  }
+  wtf_size_t n = 1;
+  if (U16_IS_LEAD(text[pos]) && pos + 1 < text.length() &&
+      U16_IS_TRAIL(text[pos + 1])) {
+    n = 2;
+  }
+  frame->GetEditor().InsertText(StringView(text, pos, n).ToString(), nullptr);
+  pos += n;
+  if (pos >= text.length()) {
+    return;
+  }
+  int delay_ms = 28 + static_cast<int>(base::RandGenerator(93));
+  if (base::RandGenerator(15) == 0) {
+    delay_ms += 150 + static_cast<int>(base::RandGenerator(301));  // a hesitation now and then
+  }
+  frame->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(FROM_HERE,
+                        BindOnce(&NebulaTypeNext, WrapWeakPersistent(frame),
+                                      text, pos),
+                        base::Milliseconds(delay_ms));
+}
+
+}  // namespace
+
 bool ClipboardCommands::ExecutePasteAndMatchStyle(LocalFrame& frame,
                                                   Event*,
                                                   EditorCommandSource source,
                                                   const String&) {
+  if (source == EditorCommandSource::kMenuOrKeyBinding) {
+    if (!frame.Selection().SelectionHasFocus() || !frame.GetEditor().CanEdit()) {
+      return false;
+    }
+    String text = frame.GetSystemClipboard()->ReadPlainText();
+    if (text.length() > kNebulaMaxTyped) {
+      text = StringView(text, 0, kNebulaMaxTyped).ToString();
+    }
+    text.Replace("\r\n", "\n");
+    NebulaTypeNext(&frame, text, 0);
+    return true;
+  }
