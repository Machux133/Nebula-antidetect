+// Nebula Sessions: --nebula-fp nolatin=1 drops typed text that has a letter outside the Latin script (a Cyrillic or
+// Greek keyboard layout would show the host's language), like "Block non-Latin input" in the original.
+bool NebulaHasNonLatinLetter(const String& text) {
+  if (text.Is8Bit()) {
+    return false;  // Latin-1 only
+  }
+  base::span<const UChar> s = text.Span16();
+  for (size_t i = 0; i < s.size();) {
+    UChar32 c;
+    U16_NEXT(s.data(), i, s.size(), c);
+    if (!u_isalpha(c)) {
+      continue;
+    }
+    UErrorCode err = U_ZERO_ERROR;
+    const UScriptCode sc = uscript_getScript(c, &err);
+    if (U_SUCCESS(err) && sc != USCRIPT_LATIN && sc != USCRIPT_COMMON &&
+        sc != USCRIPT_INHERITED) {
+      return true;
+    }
+  }
+  return false;
+}
