+// Nebula Sessions: --nebula-fp wsblock=<port,port,...>. A WebSocket to this computer (localhost, 127.x, ::1,
+// 0.0.0.0) on one of these ports is refused, so a page that probes for remote-desktop or debugging services
+// (RDP 3389, VNC 5900...) sees closed ports, as it would on a machine without them.
+bool NebulaBlocksWebSocket(const String& url) {
+  const std::string list = nebula::Get("wsblock");
+  if (list.empty()) {
+    return false;
+  }
+  const KURL parsed(NullUrl(), url);
+  if (!parsed.IsValid()) {
+    return false;
+  }
+  const String host = parsed.Host().ToString();
+  const bool loopback = host == "localhost" || host.starts_with("127.") ||
+                        host == "[::1]" || host == "0.0.0.0";
+  if (!loopback) {
+    return false;
+  }
+  const int port = parsed.HasPort() ? parsed.Port()
+                                    : (parsed.ProtocolIs("wss") ? 443 : 80);
+  for (std::string_view p : base::SplitStringPiece(
+           list, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    int blocked = 0;
+    if (base::StringToInt(p, &blocked) && blocked == port) {
+      return true;
+    }
+  }
+  return false;
+}
