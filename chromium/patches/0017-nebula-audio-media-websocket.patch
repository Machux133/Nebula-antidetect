+// Nebula Sessions: --nebula-fp mdev=<audio inputs>,<video inputs>,<audio outputs>,<group seed> is the modelled
+// machine's device list as a page sees it before any permission is granted: empty ids and labels, one group id
+// per physical device. This computer's own cameras and microphones are never listed. Returns false when the
+// key is absent or malformed, and the real list is kept.
+bool NebulaMediaDevices(MediaDeviceInfoVector& devices) {
+  const std::string spec = nebula::Get("mdev");
+  const std::vector<std::string_view> f = base::SplitStringPiece(
+      spec, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::array<unsigned, 3> counts = {0, 0, 0};
+  if (f.size() < 4) {
+    return false;
+  }
+  for (size_t i = 0; i < 3; ++i) {
+    if (!base::StringToUint(f.at(i), &counts.at(i)) || counts.at(i) > 8) {
+      return false;
+    }
+  }
+  const std::string group(f.at(3));
+  const std::array<mojom::blink::MediaDeviceType, 3> kinds = {
+      mojom::blink::MediaDeviceType::kMediaAudioInput,
+      mojom::blink::MediaDeviceType::kMediaVideoInput,
+      mojom::blink::MediaDeviceType::kMediaAudioOutput};
+  for (size_t kind = 0; kind < 3; ++kind) {
+    for (unsigned n = 0; n < counts.at(kind); ++n) {
+      // Audio in/out share a group (one headset or sound card); a camera has its own.
+      std::string id = (kind == 1 ? "v" : "g") + group;
+      if (n) {
+        id += "-" + base::NumberToString(n);
+      }
+      const String group_id = String::FromUtf8(id);
+      if (kind == 2) {
+        devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+            g_empty_string, g_empty_string, group_id, kinds.at(kind)));
+      } else {
+        devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+            g_empty_string, g_empty_string, group_id, kinds.at(kind)));
+      }
+    }
+  }
+  return true;
+}
+
